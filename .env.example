# Copy this file to .env for local dashboard development.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
# Optional. Keep any database token private; never commit the real .env file.
FIREBASE_AUTH_TOKEN=
TELEMETRY_SOURCE_PATH=soilMoisture
TELEMETRY_TIMESTAMP_FIELD=timestamp
TELEMETRY_VALUE_FIELD=value
TELEMETRY_TEMPERATURE_FIELD=tempC
PORT=8080
